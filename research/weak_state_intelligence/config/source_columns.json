  "_doc": "Logical-name -> raw-column map per frozen source. confirmed=true means the columns were checked against the registered file (src/inspect_source.py) AND its codebook on the date given. 'member' reads a CSV inside a registered zip; 'reader' is csv|stata|xlsx; 'strip_header' strips whitespace in header names only (UCDP onset country file pads ' conflict_ids').",
  "DATA_SDM": {
    "confirmed": true, "confirmed_on": "2026-10-14",
    "file_glob": "data/raw/DATA_SDM/SDM.csv",
    "columns": {
      "movement_id": "groupid", "movement_name": "group", "country_name": "country", "country_code": "ccode",
      "year": "year", "active": "active", "phase1": "phase1", "phase2": "phase2",
      "fyphase1": "fyphase1", "fyphase2": "fyphase2",
      "startdate1": "startdate1", "enddate1": "enddate1", "startdate2": "startdate2", "enddate2": "enddate2",
      "prioract": "prioract", "priorviol": "priorviol", "priorconflict": "priorconflict",
      "anti_state_violence": "violsd", "high_violence": "hviolsd", "ambiguous": "ambiguous",
      "violsd_onset": "violsd_onset", "doublecount": "doublecount",
      "sample": "sample", "weight": "weight",
      "ucdp_terrconflict": "ucdp_terrconflict", "ucdp_conflictid_old": "ucdp_conflictid"
    },
    "notes": "Rows with active==0 are the 10-year policy lookback (violsd missing). enddate 8888 = host-state change, 9999 = ongoing in 2012. A host-state change creates a NEW groupid (prioract==3); there is no predecessor ID. ccode is COW-style (see country_crosswalk). ucdp_conflictid uses old 'x-yyy' UCDP IDs and contains Excel date corruption ('Jan 99', 'Jan 54')."
  },
